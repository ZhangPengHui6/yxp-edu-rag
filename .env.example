# ---- OCR 解析（tools/rag_ingest 使用；OCR_PROVIDER=mineru|qwen_vl）----
# mineru：整份 PDF 上传，保留版面结构，公式/表格识别好（推荐）
OCR_PROVIDER=mineru
# MINERU_TOKEN 直接使用；也可改用 OpenXLab AK/SK 自动换取 JWT
MINERU_TOKEN=
MINERU_ACCESS_KEY_ID=
MINERU_SECRET_ACCESS_KEY=
MINERU_AUTH_URL=https://openapi.openxlab.org.cn/api/v1/sso-be/api/v1/open
MINERU_BASE_URL=https://mineru.net/api/v4

# qwen_vl：逐页调用千问视觉模型（OpenAI 兼容）。
# 七牛云示例：DASHSCOPE_BASE_URL=https://api.qnaigc.com/v1
#             QWEN_VL_MODEL=qwen/qwen3.7-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen2.5-vl-7b-instruct
OCR_CONCURRENCY=4
OCR_DPI=200

# ---- 渲染与切分 ----
RENDER_DPI=300
CHUNK_SIZE=600
CHUNK_OVERLAP=80
