# 环境变量示例：复制为 `.env` 后按需修改。
# 共享基础设施变量（MILVUS_URI / MONGO_URL / DASHSCOPE_* / BGE_M3_PATH 等）
# 与 apps/admin-api 共用；本地联调时可直接用 `--env-file ../admin-api/.env.remote`。

# ---- 服务 ----
KB_API_PREFIX=/v1
# 为空表示开发模式：不校验 X-API-Key，启动时打印警告。
KB_API_KEY=
KB_DEFAULT_TENANT=tnt_yxp
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 检索 ----
KB_TOP_K=20
KB_RRF_K=60
# 题目两路在 RRF 中的权重 / 融合窗口里预留给题目的槽位数。
KB_QUESTION_WEIGHT=1.0
KB_QUESTION_QUOTA=3
KB_FUSED_TOP_N=10
KB_RERANK_TOP_N=5
KB_MAX_QUESTION_CHARS=2000
KB_MAX_EVIDENCE_CHARS=1200
KB_MAX_CONTEXT_CHARS=6000
KB_HISTORY_TURNS=4
KB_ANSWER_MAX_TOKENS=2048
KB_RECORD_ANSWERS=true

# ---- 共享基础设施（通常由 admin-api 的 env 提供）----
# MILVUS_URI=http://192.168.168.100:19530
# MONGO_URL=mongodb://...
# MONGO_DB=yxp
# CHUNKS_ALIAS=chunks_active
# QUESTIONS_ALIAS=questions_active
# EMBEDDING_PROVIDER=bge_m3
# BGE_M3_PATH=C:/data/ai_models/modelscope_cache/models/models/BAAI--bge-m3/snapshots/master
# BGE_DEVICE=cpu
# DASHSCOPE_BASE_URL=https://api.qnaigc.com/v1
# DASHSCOPE_API_KEY=
# LLM_DEFAULT_MODEL=qwen/qwen3.7-flash
# LLM_TIMEOUT_SECONDS=120
# RERANK_PROVIDER=qwen_llm
