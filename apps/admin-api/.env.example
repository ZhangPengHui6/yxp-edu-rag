# ---- admin-api ----
# Local development defaults to SQLite + in-memory Mongo + local uploads +
# inline background tasks, so `uvicorn app.main:app` works with no infrastructure.
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (production). Example:
# DATABASE_URL=postgresql+asyncpg://yxp:yxp@127.0.0.1:5432/yxp
DATABASE_URL=sqlite+aiosqlite:///./data/admin.db

# MongoDB (production). Leave empty to use an in-process mongomock database.
# MONGO_URL=mongodb://127.0.0.1:27017
MONGO_URL=
MONGO_DB=yxp

# Auth
JWT_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Object storage: local | minio
OBJECT_STORAGE=local
UPLOAD_DIR=./data/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000
UPLOAD_URL_TTL=900
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=yxp

# Vector index. Empty => in-memory adapter (POC). Example: http://127.0.0.1:19530
MILVUS_URI=
MILVUS_CHUNKS_COLLECTION=chunks_live
MILVUS_QUESTIONS_COLLECTION=questions
CHUNKS_ALIAS=chunks_active
QUESTIONS_ALIAS=questions_active

# Tasks: inline (POC, same process) | celery
TASK_MODE=inline
REDIS_URL=redis://127.0.0.1:6379/0
PIPELINE_STEP_DELAY=0.4

# Seed the demo dataset on first start
SEED_ON_START=true
EVAL_RECALL_THRESHOLD=0.85

# Real ingestion pipeline.
#   auto    = MinerU first, Qwen-VL fallback (recommended)
#   mineru  = MinerU v4 cloud API only
#   qwen_vl = page-by-page Qwen-VL only
#   placeholder = simulated state machine (tests)
# Keep credentials in the repository root .env or the deployment secret store.
OCR_PROVIDER=auto
# Either a MinerU API token (used as-is) or OpenXLab AK/SK (exchanged for a JWT).
MINERU_TOKEN=
MINERU_ACCESS_KEY_ID=
MINERU_SECRET_ACCESS_KEY=
MINERU_AUTH_URL=https://openapi.openxlab.org.cn/api/v1/sso-be/api/v1/open
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
OCR_POLL_SECONDS=5
OCR_TIMEOUT_SECONDS=1800
OCR_DPI=200
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# Qwen models (OpenAI-compatible). Qiniu example:
#   DASHSCOPE_BASE_URL=https://api.qnaigc.com/v1
#   QWEN_VL_MODEL=qwen/qwen3.7-flash
#   LLM_DEFAULT_MODEL=qwen/qwen3.7-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen2.5-vl-7b-instruct
QWEN_VL_CONCURRENCY=4
QWEN_VL_MAX_TOKENS=8192
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
LLM_STRUCTURING=true
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=8192
LLM_MAX_CHARS=8000
LLM_CONCURRENCY=4

# Rerank: qwen_llm (chat scoring, works on Qiniu) | dashscope | off
RERANK_PROVIDER=qwen_llm
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_CONCURRENCY=4
RERANK_MAX_QUESTIONS=50
RERANK_CANDIDATES=6
RERANK_TOP_EVIDENCE=2

# Embedding: off (text-only ingestion) | bge_m3 (local BAAI/bge-m3).
# bge_m3 writes 1024-d dense vectors + sparse lexical weights on chunks and
# questions; the publish stage builds Milvus collections from them.
# Requires `uv sync --extra embeddings`.
EMBEDDING_PROVIDER=off
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024
# Local snapshot (ModelScope/HuggingFace directory) or a model id. Prefer a
# local path so ingestion and publish never hit the network.
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
# fp16 is only applied on CUDA; CPU inference always uses fp32.
BGE_FP16=True
